---
// Bloques de la semana: [inicio, duración] en % de la columna. k: '' confirmada · 'p' por confirmar · 'e' libre
const week = [
  { d: 'LUN', s: [[0, 18, ''], [22, 26, ''], [52, 14, 'p'], [72, 22, 'e']] },
  { d: 'MAR', s: [[6, 30, ''], [40, 14, ''], [58, 18, ''], [80, 14, 'p']] },
  { d: 'MIÉ', s: [[0, 14, 'e'], [18, 22, 'p'], [44, 30, ''], [78, 16, '']] },
  { d: 'JUE', s: [[0, 22, ''], [26, 14, ''], [44, 18, ''], [66, 28, '']] },
  { d: 'VIE', s: [[4, 18, ''], [26, 14, 'p'], [44, 22, ''], [70, 16, 'e']] },
];
const labSteps = ['Por enviar', 'Enviado', 'En proceso', 'Recibido', 'Entregado'];
const labs = [['Corona · Ana T.', 2], ['Guarda oclusal · Luis O.', 3], ['Prótesis · Elena C.', 1]];
// k: 'done' hecha · 'hot' prioridad alta
const tasks = [['Confirmar citas del viernes', 'MG', 'done'], ['Comprar anestesia', 'LR', 'hot'], ['Mantenimiento de autoclave', 'JS', ''], ['Llamar a proveedor', 'MG', '']];
const stock = [['Guantes M', 12, 'w'], ['Anestesia', 68, ''], ['Resina A2', 84, '']];
---
<section class="section wrap center" id="funciones">
  <p class="eyebrow">Funciones</p>
  <h2 class="h-display">Pensado para el día a día<br />de tu clínica.</h2>
  <p class="lead">Cada tarea, en segundos. Entre un paciente y el siguiente.</p>

  <div class="bento">
    <article class="dt-card s4" data-reveal>
      <span class="dt-card-eyebrow">Agenda</span>
      <h3 class="dt-card-title">Tu semana, de un vistazo.</h3>
      <p class="dt-card-text">Horarios por doctor, estados de cita y lista de espera.</p>
      <div class="dt-card-visual week" aria-hidden="true">
        {week.map((w, d) => <div><span>{w.d}</span><div class="day">{w.s.map(([t, h, k], j) => <i class={k as string} style={`top:${t}%;height:${h}%;--i:${d + j * 2}`} />)}</div></div>)}
      </div>
      <div class="legend" aria-hidden="true"><span><b />Confirmada</span><span><b class="p" />Por confirmar</span><span><b class="e" />Libre</span></div>
    </article>

    <article class="dt-card dt-card-brand s2 t2" data-reveal>
      <span class="dt-card-eyebrow">Recordatorios</span>
      <h3 class="dt-card-title">Confirman con un toque.</h3>
      <p class="dt-card-text">Tu agenda se actualiza sola.</p>
      <div class="dt-card-visual lock" aria-hidden="true">
        <div class="push">
          <div class="push-h"><span class="app"></span>Dentastika<small>ahora</small></div>
          <strong>Tu cita es mañana</strong>
          <p>10:30 con la Dra. Ruiz</p>
          <div class="push-a"><span>Confirmar</span><span>Reprogramar</span></div>
        </div>
        <div class="push ghost">
          <div class="push-h"><span class="app"></span>Dentastika<small>hace 2 días</small></div>
          <strong>Presupuesto disponible</strong>
        </div>
      </div>
    </article>

    <article class="dt-card dt-card-enamel s3" data-reveal>
      <span class="dt-card-eyebrow">Presupuestos</span>
      <h3 class="dt-card-title">Cada peso, claro.</h3>
      <div class="dt-card-visual receipt" aria-hidden="true">
        <div><span>Presupuestado</span><b class="dt-num">$3,200</b></div>
        <div><span>Pagado</span><b class="dt-num">$2,000</b></div>
        <div class="tot"><span>Saldo</span><span class="dt-badge dt-badge-brand">$1,200</span></div>
      </div>
    </article>

    <article class="dt-card s3" data-reveal>
      <span class="dt-card-eyebrow">Inventario</span>
      <h3 class="dt-card-title">Nunca te quedes sin insumos.</h3>
      <p class="dt-card-text">Lotes, caducidades y alertas de stock.</p>
      <div class="dt-card-visual stock" aria-hidden="true">
        {stock.map(([n, v, k], j) => <div><span>{n}</span><i class={k}><u style={`width:${v}%;--i:${j}`} /></i></div>)}
      </div>
    </article>

    <article class="dt-card dt-card-sunken s3" data-reveal>
      <span class="dt-card-eyebrow">Laboratorios</span>
      <h3 class="dt-card-title">Sabe dónde va cada trabajo.</h3>
      <p class="dt-card-text">Envíos, entregas y proveedores, en orden.</p>
      <div class="dt-card-visual labs" aria-hidden="true">
        {labs.map(([n, step], j) => (
          <div class="job" style={`--j:${j}`}>
            <div class="job-h"><strong>{n}</strong><small>{labSteps[step as number]}</small></div>
            <div class="track">{labSteps.map((_, i) => <i class:list={{ done: i < (step as number), now: i === step }} style={`--i:${i}`} />)}</div>
          </div>
        ))}
      </div>
    </article>

    <article class="dt-card s3" data-reveal>
      <span class="dt-card-eyebrow">Tareas</span>
      <h3 class="dt-card-title">Nada se queda pendiente.</h3>
      <p class="dt-card-text">Responsables, fechas y control de equipo.</p>
      <div class="dt-card-visual tasks" aria-hidden="true">
        {tasks.map(([t, who, k], j) => (
          <div class:list={['task', k]} style={`--i:${j}`}><span class="check" /><span class="tt">{t}</span><span class="who">{who}</span></div>
        ))}
      </div>
    </article>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(300px, auto); gap: var(--space-3); margin-top: 64px; text-align: left; }
  .s2 { grid-column: span 2; } .s3 { grid-column: span 3; } .s4 { grid-column: span 4; }
  .week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .week div { display: flex; flex-direction: column; gap: 6px; }
  .week span { font: 500 11px/1 var(--font-mono); color: var(--ink-muted); text-align: center; padding-bottom: 4px; }
  .day { position: relative; height: 150px; }
  .day i { position: absolute; left: 0; right: 0; border-radius: 6px; background: var(--brand-soft); box-shadow: inset 3px 0 0 var(--brand); }
  .day i.p { background: var(--enamel); box-shadow: inset 3px 0 0 var(--warning); }
  .day i.e { background: none; box-shadow: none; border: 1.5px dashed var(--hairline); }
  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-top: 18px; font: 500 12px/1 var(--font-sans); color: var(--ink-muted); }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend b { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: var(--brand-soft); box-shadow: inset 2px 0 0 var(--brand); }
  .legend b.p { background: var(--enamel); box-shadow: inset 2px 0 0 var(--warning); }
  .legend b.e { background: none; box-shadow: none; border: 1.5px dashed var(--hairline); }
  .lock { display: flex; flex-direction: column; gap: 10px; }
  .push { padding: 12px 14px; border-radius: 18px; background: color-mix(in srgb, var(--surface-raised) 88%, transparent); box-shadow: var(--shadow-card); backdrop-filter: blur(12px); }
  .push-h { display: flex; align-items: center; gap: 8px; font: 600 12px/1 var(--font-sans); color: var(--ink-muted); }
  .push-h small { margin-left: auto; font-weight: 500; }
  .app { width: 18px; height: 18px; border-radius: 5px; background: var(--brand); position: relative; }
  .app::after { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: var(--on-brand); }
  .push strong { display: block; margin-top: 8px; font: 600 15px/1.3 var(--font-sans); color: var(--ink); }
  .push p { margin: 2px 0 0; font: 400 14px/1.35 var(--font-sans); color: var(--ink-muted); }
  .push-a { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 12px; }
  .push-a span { padding: 8px 0; border-radius: 10px; background: var(--surface-sunken); text-align: center; font: 600 13px/1 var(--font-sans); color: var(--ink); }
  .push-a span:first-child { background: var(--brand); color: var(--on-brand); }
  .push.ghost { opacity: .55; transform: scale(.96); }
  .receipt { display: grid; gap: 10px; padding: 14px 16px; border-radius: var(--radius-md); background: var(--surface-raised); box-shadow: var(--shadow-card); font: 500 14px/1.2 var(--font-sans); }
  .receipt div { display: flex; justify-content: space-between; align-items: center; }
  .receipt span:first-child { color: var(--ink-muted); }
  .receipt .tot { padding-top: 10px; border-top: 1px solid var(--hairline); font-weight: 600; font-size: 17px; }
  .receipt .tot span:first-child { color: var(--ink); }
  .stock { display: grid; gap: 12px; }
  .stock div { display: grid; gap: 6px; }
  .stock span { font: 500 13px/1 var(--font-sans); color: var(--ink-muted); }
  .stock i { display: block; height: 8px; border-radius: 4px; background: var(--hairline); overflow: hidden; }
  .stock u { display: block; height: 100%; border-radius: 4px; background: var(--brand); }
  .stock i.w u { background: var(--warning); }
  .labs, .tasks { display: grid; gap: 10px; }
  .job { padding: 12px 14px; border-radius: var(--radius-md); background: var(--surface-raised); }
  .job-h { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .job-h strong { font: 600 14px/1.2 var(--font-sans); }
  .job-h small { font: 500 12px/1 var(--font-sans); color: var(--brand); white-space: nowrap; }
  .track { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; margin-top: 10px; }
  .track i { height: 6px; border-radius: 3px; background: var(--hairline); }
  .track i.done { background: var(--brand); }
  .track i.now { background: var(--brand); opacity: .45; }
  .task { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: var(--radius-md); background: var(--surface-sunken); font: 500 14px/1.2 var(--font-sans); }
  .check { flex: none; width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--hairline); }
  .task.done .check { background: var(--brand); box-shadow: none; }
  .task.done .check::after { content: ""; display: block; width: 5px; height: 9px; margin: 3px 0 0 6.5px; border: solid var(--on-brand); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .task.done .tt { color: var(--ink-muted); text-decoration: line-through; }
  .task.hot .check { box-shadow: inset 0 0 0 1.5px var(--warning); }
  .tt { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .who { flex: none; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--enamel); font: 600 10px/1 var(--font-sans); color: var(--ink); }

  @media (max-width: 960px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .s2, .s3 { grid-column: span 1; } .s4, .t2 { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .s2, .s3, .s4, .t2 { grid-column: auto; }
  }
</style>
