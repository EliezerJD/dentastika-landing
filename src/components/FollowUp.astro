---
const cols = [
  { title: 'Hoy', badge: 'dt-badge-brand', items: [['Ana Torres', 'Limpieza · 6 meses'], ['Roberto Núñez', 'Revisión periódica']] },
  { title: 'Próximos', badge: '', items: [['Sofía Ramos', 'Control mensual · 3 oct'], ['Diego Vargas', 'Limpieza · 12 oct']] },
  { title: 'Vencidos', badge: 'dt-badge-danger', items: [['Laura Beltrán', 'Control mensual · hace 5 días']] },
];
---
<section class="section wrap center" id="seguimiento">
  <p class="eyebrow">Seguimiento</p>
  <h2 class="h-display">Que ningún paciente<br />se quede sin volver.</h2>
  <p class="lead">Programa el siguiente contacto al terminar la cita. Cuando llegue la fecha, lo verás en tu lista.</p>

  <div class="board">
    {cols.map((c) => (
      <div class="dt-card col" data-reveal>
        <div class="col-head"><h3>{c.title}</h3><span class:list={['dt-badge', c.badge]}>{c.items.length}</span></div>
        {c.items.map(([who, what], j) => <div class="item" style={`--i:${j}`}><strong>{who}</strong><small>{what}</small></div>)}
      </div>
    ))}
  </div>

  <p class="kinds">Limpiezas cada 6 meses, revisiones, controles mensuales o la fecha que tú elijas.</p>
</section>

<style>
  .board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); margin-top: 64px; text-align: left; align-items: start; }
  .col { gap: var(--space-3); padding: var(--space-6); }
  .col-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 4px; }
  .col-head h3 { margin: 0; font: 600 19px/1.2 var(--font-sans); letter-spacing: -0.015em; }
  .item { padding: 12px 14px; border-radius: var(--radius-md); background: var(--surface-sunken); }
  .item strong { display: block; font: 600 15px/1.3 var(--font-sans); }
  .item small { display: block; margin-top: 3px; font: 500 13px/1.3 var(--font-sans); color: var(--ink-muted); }
  .kinds { margin: 32px auto 0; max-width: 560px; font: 500 15px/1.5 var(--font-sans); color: var(--ink-muted); text-wrap: balance; }
  @media (max-width: 860px) { .board { grid-template-columns: 1fr; } }
</style>
